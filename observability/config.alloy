logging {
  level = "warn"
}
otelcol.receiver.otlp "frontend" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.processor.memory_limiter.frontend.input]
    traces = [otelcol.processor.memory_limiter.frontend.input]
    logs = [otelcol.processor.memory_limiter.frontend.input]
  }
}
otelcol.processor.memory_limiter "frontend" {
  check_interval = "1s"
  limit = "384MiB"
  output {
    metrics = [otelcol.processor.transform.local.input]
    traces = [otelcol.processor.transform.local.input]
    logs = [otelcol.processor.transform.local.input]
  }
}
// 이 수신기는 로컬 전용이다. AWS dev/prod는 이 endpoint를 사용하지 않는다.
otelcol.processor.transform "local" {
  error_mode = "ignore"
  metric_statements {
    context = "resource"
    statements = ["set(attributes[\"deployment.environment.name\"], \"local\")"]
  }
  trace_statements {
    context = "resource"
    statements = ["set(attributes[\"deployment.environment.name\"], \"local\")"]
  }
  log_statements {
    context = "resource"
    statements = ["set(attributes[\"deployment.environment.name\"], \"local\")"]
  }
  output {
    metrics = [otelcol.processor.batch.frontend.input]
    traces = [otelcol.processor.batch.frontend.input]
    logs = [otelcol.processor.batch.frontend.input]
  }
}
otelcol.processor.batch "frontend" {
  timeout = "5s"
  send_batch_size = 512
  send_batch_max_size = 1024
  output {
    metrics = [otelcol.exporter.prometheus.local.input]
    traces = [otelcol.exporter.otlphttp.tempo.input]
    logs = [otelcol.exporter.otlphttp.loki.input]
  }
}
otelcol.exporter.prometheus "local" {
  resource_to_telemetry_conversion = true
  forward_to = [prometheus.remote_write.local.receiver]
}
prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
  }
}
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}

faro.receiver "rum" {
  log_format = "json"
  extra_log_labels = { job = "frontend-rum" }
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    max_allowed_payload_size = "16KiB"
    include_metadata = false
    rate_limiting {
      enabled = true
      rate = 20
      burst_size = 40
    }
  }
  sourcemaps {
    download = false
  }
  output {
    logs = [loki.write.rum.receiver]
  }
}
loki.write "rum" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
