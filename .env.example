# 브라우저 → Dashboard: 조회·분석·카탈로그
NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:8081
# 브라우저 → Enrollment: 관리 명령·토큰 갱신·로그아웃
NEXT_PUBLIC_ENROLLMENT_API_URL=http://localhost:8080
# Next 서버 → 같은 Enrollment: 시드 계정의 비밀번호 로그인
ENROLLMENT_API_URL=http://localhost:8080
# 로컬 시드 로그인 전용. 이메일 입력 후 Next 서버가 시드 비밀번호를 보충해 인증합니다.
DEV_SEED_AUTH_ENABLED=false
# backend/tools/dev-seed/README.md의 개발용 비밀번호를 로컬 환경에만 설정합니다.
DEV_SEED_AUTH_PASSWORD=
# 실제 시드를 생성한 기준일(YYYY-MM-DD). E2E가 시드를 초기화하지는 않습니다.
E2E_SEED_DATE=
