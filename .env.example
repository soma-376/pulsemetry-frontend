# 자동 추이: PROJ-315 정책 통합 검증 후 true로 빌드. 기본/복구는 false로 재빌드한다.
NEXT_PUBLIC_AUTO_TREND_ENABLED=false
# 브라우저의 OIDC authorize 페이지 이동에만 사용하는 공개 주소
NEXT_PUBLIC_ENROLLMENT_API_URL=http://localhost:8080
# 브라우저가 호출할 BFF origin. 비우면 화면과 동일 출처를 사용한다.
# NEXT_PUBLIC_ 값은 빌드 시 반영된다. 로컬 변경 후 개발 서버를 재시작한다.
NEXT_PUBLIC_BFF_ORIGIN=
# BFF 요청의 credentials와 공통 헤더는 src/lib/api/bff-fetch.ts에서 관리한다.
# BFF → 백엔드 (서버 전용)
ENROLLMENT_API_URL=http://localhost:8080
DASHBOARD_API_URL=http://localhost:8081
# 브라우저에서 접속하는 정확한 origin. 운영은 https 필수
BFF_ORIGIN=http://localhost:3000
# openssl rand -hex 32 로 생성. 현재 키,이전 키 순서로 최대 3개. NEXT_PUBLIC_ 금지
BFF_SESSION_KEYS=
# OIDC client secret은 백엔드에만 설정한다.
# E2E 테스트에서만 사용하는 DB 시드 기준일
E2E_SEED_DATE=

# 서버 관측성: 기본은 비활성. npm run dev:otel은 아래 값을 로컬용으로 지정한다.
# NODE_ENV는 빌드/실행 모드이므로 배포 환경(local/dev/prod)과 별도로 관리한다.
OTEL_SDK_DISABLED=true
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_SERVICE_NAME=pulsemetry-frontend
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14318

# 공유 세션: Valkey 필수. 연결 절차는 docs/valkey-sessions.md 참조.
# BFF_SESSION_ENV=dev
# BFF_VALKEY_HOST=<private endpoint>.cache.amazonaws.com
# BFF_VALKEY_CACHE_NAME=pulsemetry-frontend-shared
# BFF_VALKEY_USERNAME=pulsemetry-bff-dev
# AWS_REGION=ap-northeast-2

# dev BFF에서만 허용할 로컬 웹 origin 목록. dev ECS에 주입하며 prod는 비워 둔다.
# 각 origin의 /auth/callback만 해당 Origin의 코드 교환에 허용한다.
# BFF_LOCAL_ORIGINS=http://localhost:3000
