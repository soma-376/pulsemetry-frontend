# 브라우저의 OIDC authorize 페이지 이동에만 사용하는 공개 주소
NEXT_PUBLIC_ENROLLMENT_API_URL=http://localhost:8080
# BFF → 백엔드 (서버 전용)
ENROLLMENT_API_URL=http://localhost:8080
DASHBOARD_API_URL=http://localhost:8081
# 브라우저에서 접속하는 정확한 origin. 운영은 https 필수
BFF_ORIGIN=http://localhost:3000
# openssl rand -hex 32 로 생성. 현재 키,이전 키 순서로 최대 3개. NEXT_PUBLIC_ 금지
BFF_SESSION_KEYS=
# OIDC client secret은 백엔드에만 설정한다.
# E2E 테스트에서만 사용하는 DB 시드 기준일
E2E_SEED_DATE=

# 서버 관측성: 기본은 비활성. npm run dev:otel은 아래 값을 로컬용으로 지정한다.
# NODE_ENV는 빌드/실행 모드이므로 배포 환경(local/dev/prod)과 별도로 관리한다.
OTEL_SDK_DISABLED=true
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_SERVICE_NAME=pulsemetry-frontend
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14318
