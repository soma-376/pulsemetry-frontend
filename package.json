{
  "name": "pulsemetry-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "check:browser": "node scripts/check-browser.mjs",
    "test": "vitest run",
    "generate:api": "openapi-typescript docs/reference/pulsemetry_api_spec.yaml -o src/api/schema.d.ts --default-non-nullable false",
    "check:shell": "node scripts/check-shell.mjs",
    "check:teams": "node scripts/check-teams.mjs",
    "check:team-details": "node scripts/check-team-details.mjs",
    "check:overview": "node scripts/check-overview.mjs",
    "check:operations": "node scripts/check-operations.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "msw": "^2.15.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
